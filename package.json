{
  "name": "studybuddy",
  "version": "1.0.0",
  "description": "StudyBuddy - a study planner and note-sharing web app (HTML, CSS, JavaScript, XML, Node.js, MongoDB)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test scripts/api.test.js",
    "audit": "node scripts/a11y-audit.js",
    "validate:html": "html-validate \"public/*.html\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "html-validate": "^11.17.0",
    "playwright-core": "^1.64.1"
  }
}
