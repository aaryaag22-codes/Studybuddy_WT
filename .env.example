# Copy this file to ".env" and fill in the values. NEVER commit the .env file.

# MongoDB connection string.
#  - Local MongoDB:   mongodb://127.0.0.1:27017/studybuddy
#  - MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studybuddy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/studybuddy

# A long random text used to sign login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-text

# Port for the website (Render sets this by itself)
PORT=3000
